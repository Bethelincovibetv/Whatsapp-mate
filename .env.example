# ==============================================================================
# Baileys WhatsApp Auto-Tag & Cloud SQL Environment Configuration
# ==============================================================================

# Server Port (Default: 3000 for Google Cloud Run compatibility)
PORT=3000

# WhatsApp Bot Session Identifier
SESSION_ID=cloudsql_baileys_session

# Optional Default WhatsApp Phone Number with country code (e.g., 14155552671)
# If provided, the server can immediately request a pairing code upon startup
PHONE_NUMBER=

# ==============================================================================
# Google Cloud SQL (PostgreSQL) Configuration
# ==============================================================================
# Option A: Full Connection String (Standard Postgres or Cloud SQL SSL)
# DATABASE_URL=postgresql://postgres:your_secure_password@34.120.10.50:5432/baileys_db?sslmode=require

# Option B: Cloud SQL Unix Socket (Recommended for Google Cloud Run)
# Cloud Run automatically mounts Cloud SQL instances under /cloudsql/INSTANCE_CONNECTION_NAME
INSTANCE_CONNECTION_NAME=your-gcp-project:region:your-cloudsql-instance
DB_NAME=baileys_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Option C: Direct Host & Port Parameters
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL=false

# ==============================================================================
# Auto-Tag Everyone Automation Settings
# ==============================================================================
# Enable/Disable auto-tagging when owner sends a message
AUTO_TAG_ENABLED=true

# Trigger Mode: 'all' = every message sent by owner, 'keyword' = only when message contains trigger keyword
AUTO_TAG_TRIGGER=all

# Trigger Keyword (Only applies if AUTO_TAG_TRIGGER=keyword)
AUTO_TAG_KEYWORD=!everyone

# Cooldown between auto-tags in the same group (in seconds) to prevent spamming
TAG_COOLDOWN_SECONDS=3

# Mention display format: 'announcement' | 'standard' | 'compact'
MENTION_FORMAT=announcement

# Debug logging for Baileys internal socket events ('true' | 'false')
DEBUG_BAILEYS=false
